# escape=`
# Dockerfile for CEAPI (Windows container)
# Build context: the CEAPI directory.
# Stage the ICE native DLLs into CEAPI\bin\ before building.

FROM mcr.microsoft.com/windows/servercore:ltsc2022
SHELL ["powershell", "-NoLogo", "-NoProfile", "-Command", "$ErrorActionPreference = 'Stop';"]

WORKDIR C:/app

# Install Java 17 on the Windows base image.
RUN $ProgressPreference = 'SilentlyContinue'; `
    $jdkZip = 'C:\\jdk17.zip'; `
    Invoke-WebRequest -Uri 'https://aka.ms/download-jdk/microsoft-jdk-17-windows-x64.zip' -OutFile $jdkZip; `
    Expand-Archive -Path $jdkZip -DestinationPath 'C:\\'; `
    $jdkRoot = (Get-ChildItem 'C:\\' -Directory | Where-Object { $_.Name -like 'jdk-*' } | Sort-Object Name | Select-Object -First 1).FullName; `
    if (-not $jdkRoot) { throw 'JDK 17 installation folder not found after extraction.' }; `
    if (Test-Path 'C:\\jdk-17') { Remove-Item 'C:\\jdk-17' -Recurse -Force }; `
    Move-Item -Path $jdkRoot -Destination 'C:\\jdk-17'; `
    Remove-Item $jdkZip -Force

ENV JAVA_HOME=C:\jdk-17
ENV PATH=C:\jdk-17\bin;C:\Windows\system32;C:\Windows;C:\Windows\System32\Wbem;C:\Windows\System32\WindowsPowerShell\v1.0\
ENV JAVA_TOOL_OPTIONS=-Djna.library.path=C:\app\bin

# ICE's native libraries (dbcapi_64VC17.dll, PortLib_64VC17.dll) are built with the
# Visual C++ toolset and depend on the VC++ runtime (vcruntime140.dll, msvcp140.dll, etc.),
# which the minimal Server Core base image does not include. Without it, JNA's LoadLibrary
# fails on the missing dependency and surfaces only a generic "Could not load libraries" error.
RUN $ProgressPreference = 'SilentlyContinue'; `
    $vcRedist = 'C:\\vc_redist.x64.exe'; `
    Invoke-WebRequest -Uri 'https://aka.ms/vs/17/release/vc_redist.x64.exe' -OutFile $vcRedist; `
    $proc = Start-Process -FilePath $vcRedist -ArgumentList '/install', '/quiet', '/norestart' -Wait -NoNewWindow -PassThru; `
    Remove-Item $vcRedist -Force; `
    if ($proc.ExitCode -notin @(0, 3010, 1638)) { throw "vc_redist install failed with exit code $($proc.ExitCode)" }

# GitHub Actions builds the distribution before invoking Docker.
COPY build/install/ceapi/ C:/app/
COPY bin/ C:/app/bin/

RUN $requiredFiles = @( `
      'C:\app\bin\ceapi.bat', `
      'C:\app\lib\ceapi-1.0-SNAPSHOT.jar', `
      'C:\app\bin\PortLib_64VC17.dll', `
      'C:\app\bin\dbcapi_64VC17.dll' `
    ); `
    foreach ($path in $requiredFiles) { `
      if (-not (Test-Path -LiteralPath $path -PathType Leaf)) { throw "Required CEAPI runtime artifact missing: $path" } `
    }

# Temporary diagnostic: attempt to LoadLibrary the ICE native DLLs directly at build time
# so a real Win32 error code (e.g. 126 = dependency missing, with which dependency reported
# via loader snaps) shows up in the build log instead of JNA's generic wrapper message.
# NOTE: Docker's backtick line-continuation joins every line with a single space before
# handing the instruction to the shell, which breaks PowerShell here-strings (they require
# a real newline after the opening '@'). Build the type definition as a plain semicolon-joined
# string instead.
RUN $ErrorActionPreference = 'Stop'; `
    $src = 'using System; using System.Runtime.InteropServices; public class NativeLoader { [DllImport("kernel32.dll", SetLastError = true, CharSet = CharSet.Unicode)] public static extern IntPtr LoadLibraryEx(string lpFileName, IntPtr hFile, uint dwFlags); }'; `
    Add-Type -TypeDefinition $src; `
    $vcFiles = @('C:\Windows\System32\vcruntime140.dll', 'C:\Windows\System32\vcruntime140_1.dll', 'C:\Windows\System32\msvcp140.dll'); `
    foreach ($f in $vcFiles) { Write-Host "$f present: $(Test-Path -LiteralPath $f)" }; `
    $dlls = @('C:\app\bin\PortLib_64VC17.dll', 'C:\app\bin\dbcapi_64VC17.dll'); `
    foreach ($dll in $dlls) { `
        $h = [NativeLoader]::LoadLibraryEx($dll, [IntPtr]::Zero, 0); `
        if ($h -eq [IntPtr]::Zero) { `
            $err = [System.Runtime.InteropServices.Marshal]::GetLastWin32Error(); `
            Write-Host "LoadLibraryEx FAILED for $dll : Win32 error $err"; `
        } else { `
            Write-Host "LoadLibraryEx OK for $dll"; `
        } `
    }

EXPOSE 9002

ENTRYPOINT ["C:\\app\\bin\\ceapi.bat"]
