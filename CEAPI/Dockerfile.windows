# Dockerfile for CEAPI (Windows container)
# Build context: the CEAPI directory. Copy the ICE native DLLs from:
# C:\Users\Satyend.Appiah\OneDrive - Braemar plc\Documents\DELTA Drive\Scripts\Azure Deployments\Atlas\Atlas-main\Atlas-main\Java_SDK_01_031_0001
# into CEAPI\bin\ before building.

FROM mcr.microsoft.com/windows/servercore:ltsc2022
SHELL ["powershell", "-Command", "$ErrorActionPreference = 'Stop';"]

WORKDIR C:\app

# Install Java 17 on the Windows base image.
RUN $jdkZip = 'C:\jdk17.zip'; \
    Invoke-WebRequest -Uri 'https://aka.ms/download-jdk/microsoft-jdk-17-windows-x64.zip' -OutFile $jdkZip; \
    Expand-Archive -Path $jdkZip -DestinationPath 'C:\'; \
    $jdkRoot = Get-ChildItem 'C:\' -Directory | Where-Object { $_.Name -like 'jdk-*' } | Sort-Object Name | Select-Object -First 1 | ForEach-Object { $_.FullName }; \
    [System.Environment]::SetEnvironmentVariable('JAVA_HOME', $jdkRoot, 'Machine'); \
    $envPath = [System.Environment]::GetEnvironmentVariable('Path', 'Machine'); \
    $newPath = $envPath + ';' + $jdkRoot + '\bin'; \
    [System.Environment]::SetEnvironmentVariable('Path', $newPath, 'Machine'); \
    Remove-Item $jdkZip -Force

# Copy project sources and libs into the image.
COPY . C:\app

# Ensure native libraries are present at runtime under C:\app\bin.
# Copy PortLib_64VC17.dll and dbcapi_64VC17.dll from the local SDK folder into CEAPI\bin\ first.
COPY bin/ C:\app\bin\

# Build the project using Gradle. This produces classes/jars under build/.
RUN cd C:\app && .\gradlew.bat --no-daemon build -x test

# Expose the websocket port.
EXPOSE 9002

# Set JNA library path so the JStandard SDK can load the native DLLs.
ENV JAVA_TOOL_OPTIONS="-Djna.library.path=C:\\app\\bin"

# Run the main class directly on the assembled classpath.
ENTRYPOINT ["powershell", "-Command", "java -Djna.library.path=C:\\app\\bin -cp 'build\\libs\\*;lib\\*' com.braemar.ceapi.Main"]
