<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <!-- ICE's contract lists, built into the assembly so they are found wherever the code runs. See JsonInstrumentCatalogue. -->
    <EmbeddedResource Include="Catalogue\ice-instruments.json" />
    <EmbeddedResource Include="Catalogue\ice-options.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Atlas.Web.Core\Atlas.Web.Core.csproj" />
  </ItemGroup>
</Project>
