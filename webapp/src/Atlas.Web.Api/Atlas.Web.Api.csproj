<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Run via the signed dotnet host: Defender ASR on Braemar laptops blocks freshly built .exe files -->
    <UseAppHost>false</UseAppHost>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>37d81285-fc57-4503-a95d-f83135667b81</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="System.Reactive" Version="6.0.1" />
    <PackageReference Include="System.Linq.Async" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Atlas.Web.Core\Atlas.Web.Core.csproj" />
    <ProjectReference Include="..\Atlas.Web.Data\Atlas.Web.Data.csproj" />
    <ProjectReference Include="..\Atlas.Web.Ice\Atlas.Web.Ice.csproj" />
  </ItemGroup>
</Project>
